NODE_PORT=4205
HOST=https://www.google.com/
BLUR_THRESHOLD=10
BLUR_SIGMA=1.5

# Storage backend: "local" (default) or "s3" (also accepts "r2")
STORAGE_BACKEND=local

# --- S3 / R2 settings (required when STORAGE_BACKEND=s3) ---
# For AWS S3:    leave S3_ENDPOINT empty and set S3_REGION to e.g. us-east-1
# For Cloudflare R2: set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com and S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing — keep true for R2 and S3-compatible services; set false for AWS S3 virtual-hosted
S3_FORCE_PATH_STYLE=true
